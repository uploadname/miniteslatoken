            <div id="timeLeft" style="font-size: 2rem; font-weight: bold;">30s</div>
        </div>
        <div style="display: inline-block; background: rgba(0,0,0,0.5); padding: 1rem 2rem; border-radius: 15px; margin: 0 1rem;">
