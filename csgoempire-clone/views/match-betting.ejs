<script>
let currentBet = null;

function switchTab(game) {
    // Hide all sections
    document.querySelectorAll('.matches-section').forEach(section => {
        section.style.display = 'none';
    });
    
    // Show selected section
    document.getElementById(game + '-matches').style.display = 'block';
    
    // Update tab buttons
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.style.background = 'transparent';
        btn.classList.remove('active');
    });
    
    event.target.style.background = 'linear-gradient(45deg, #ff6b35, #f7931e)';
    event.target.classList.add('active');
}

function placeBet(team, odds) {
    currentBet = { team, odds };
    
    document.getElementById('betTeam').textContent = team;
    document.getElementById('betOdds').textContent = odds + 'x';
    
    updatePotentialWin();
    document.getElementById('betSlip').style.display = 'block';
}

function updatePotentialWin() {
    const amount = parseFloat(document.getElementById('betAmount').value) || 0;
    const odds = currentBet ? currentBet.odds : 1;
    const potentialWin = (amount * odds).toFixed(2);
    
    document.getElementById('potentialWin').textContent = '$' + potentialWin;
}

function confirmBet() {
    const amount = document.getElementById('betAmount').value;
    if (amount < 1) {
        alert('Minimum bet is $1');
        return;
    }
    
    const potentialWin = (amount * currentBet.odds).toFixed(2);
    alert('Bet placed: $' + amount + ' on ' + currentBet.team + '\\nPotential win: $' + potentialWin);
    
    closeBetSlip();
}

function closeBetSlip() {
    document.getElementById('betSlip').style.display = 'none';
    currentBet = null;
}

// Update potential win when amount changes
document.getElementById('betAmount').addEventListener('input', updatePotentialWin);

// Add hover effects to match cards
document.querySelectorAll('.match-card').forEach(card => {
    card.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-5px)';
        this.style.boxShadow = '0 15px 30px rgba(0,0,0,0.3)';
        this.style.borderColor = '#ff6b35';
    });
    
    card.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0)';
        this.style.boxShadow = 'none';
        this.style.borderColor = 'rgba(255,255,255,0.1)';
    });
});
</script>
