<script>
let selectedSide = null;

function selectSide(side) {
    selectedSide = side;
    document.getElementById('createGameBtn').disabled = false;
    
    // Update visual selection
    document.querySelectorAll('.side-option').forEach(option => {
        option.style.border = '2px solid transparent';
    });
    
    event.target.closest('.side-option').style.border = '2px solid #ff6b35';
}

function setCoinflipAmount(amount) {
    document.getElementById('coinflipAmount').value = amount;
}

function createCoinflipGame() {
    if (!selectedSide) {
        alert('Please select a side first!');
        return;
    }
    
    const amount = document.getElementById('coinflipAmount').value;
    if (amount < 1) {
        alert('Minimum bet is $1');
        return;
    }
    
    alert('Coinflip game created! Waiting for opponent...');
    
    // In a real implementation, this would create a new game via socket
    if (typeof socket !== 'undefined' && socket) {
        socket.emit('create-coinflip', {
            side: selectedSide,
            amount: parseFloat(amount),
            player: 'You'
        });
    }
}

function joinCoinflip(gameId, side) {
    alert('Joined coinflip game #' + gameId + ' as ' + side);
    
    // In a real implementation, this would join the game and start the flip
    if (typeof socket !== 'undefined' && socket) {
        socket.emit('join-coinflip', {
            gameId: gameId,
            side: side,
            player: 'You'
        });
    }
}
</script>

<style>
@keyframes coinFlip {
    0% { transform: rotateY(0deg); }
    50% { transform: rotateY(180deg); }
    100% { transform: rotateY(360deg); }
}

.side-option:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
}

.coinflip-game:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.3);
