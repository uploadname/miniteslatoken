    ],
    premium: [
        { name: 'AWP | Dragon Lore', value: 2847.50, rarity: 'legendary', emoji: '🐉' },
        { name: 'Butterfly Knife | Doppler', value: 1567.25, rarity: 'legendary', emoji: '🦋' },
        { name: 'AK-47 | Fire Serpent', value: 456.75, rarity: 'epic', emoji: '🐍' }
    ],
    diamond: [
        { name: 'Karambit | Crimson Web', value: 3245.00, rarity: 'legendary', emoji: '🕷️' },
        { name: 'AWP | Medusa', value: 2156.50, rarity: 'legendary', emoji: '🐍' },
        { name: 'M4A4 | Poseidon', value: 789.25, rarity: 'epic', emoji: '🔱' }
    ]
};

function openCase(caseType) {
    // Show opening animation
    document.getElementById('caseOpeningModal').style.display = 'flex';
    
    // Simulate case opening delay
    setTimeout(() => {
        document.getElementById('caseOpeningModal').style.display = 'none';
        showResult(caseType);
    }, 3000);
}

function showResult(caseType) {
    const caseItems = skins[caseType] || skins.empire;
    const wonSkin = caseItems[Math.floor(Math.random() * caseItems.length)];
    
    document.getElementById('wonSkin').textContent = wonSkin.emoji;
    document.getElementById('skinName').textContent = wonSkin.name;
    document.getElementById('skinValue').textContent = '$' + wonSkin.value.toFixed(2);
    
    // Set rarity color
    const rarityColors = {
        common: '#4a90e2',
        rare: '#9b59b6',
        epic: '#e74c3c',
        legendary: '#ffd700'
    };
    
    document.getElementById('wonSkin').style.background = 
        'linear-gradient(45deg, ' + rarityColors[wonSkin.rarity] + ', ' + rarityColors[wonSkin.rarity] + '88)';
    
    document.getElementById('resultModal').style.display = 'flex';
}

function sellSkin() {
    alert('Skin sold! Empire Coins added to your balance.');
    closeModal();
}

function closeModal() {
    document.getElementById('resultModal').style.display = 'none';
}

function createBattle(type) {
    alert('Creating ' + type + ' case battle... (Feature coming soon!)');
}

// Add hover effects
document.querySelectorAll('.case-item').forEach(item => {
    item.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-10px)';
        this.style.boxShadow = '0 20px 40px rgba(0,0,0,0.3)';
        this.style.borderColor = '#ff6b35';
    });
    
    item.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0)';
        this.style.boxShadow = 'none';
        this.style.borderColor = 'rgba(255,255,255,0.1)';
    });
});
</script>

<style>
@keyframes caseShake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

@keyframes progressFill {
    0% { width: 0%; }
    100% { width: 100%; }
}

.case-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
}

.battle-option:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.3);
}
</style>
